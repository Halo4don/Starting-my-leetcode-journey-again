# LeetCode 49. Group Anagrams
# https://leetcode.com/problems/group-anagrams/
#
# Approach: Anagrams share the same letters, so sorting each word's letters
# gives a canonical key that all anagrams of that word will share. Group
# words into a dict keyed by their sorted form.

This was my initial solution.

def groupAnagrams(self, strs):
        answer = {}
        for word in strs:
            sorted_word = ''.join(sorted(word))

            if sorted_word in answer:
                answer[sorted_word].append(word)
            else:
                answer[sorted_word] = [word]

        return answer.values()

